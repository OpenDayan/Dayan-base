        <mxCell id="host-title" value="&lt;b&gt;主机支持系统&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Noto Sans CJK SC;fontSize=17;fontColor=#344054;spacing=0;" vertex="1" parent="1">
