        <mxCell id="control-memory" value="&lt;b&gt;控制与存储&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#667085&quot;&gt;邮箱 · 门铃 / MSIP · 中断状态&lt;br&gt;设备内存 · 一致性共享区 · 核内 URAM&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CDBA9E;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#533315;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
