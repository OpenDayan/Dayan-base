        <mxCell id="service" value="&lt;b&gt;dayan_server / 服务层&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475467&quot;&gt;装载 BL1 与设备端操作系统 · 重定位算子&lt;br&gt;逻辑任务放置 · Proc 生命周期与资源分配&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#B8C2CF;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#1D2939;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
