        <mxCell id="scheduler-core" value="&lt;b&gt;调度与 Proc 管理&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475467&quot;&gt;就绪 / 等待队列 · 上下文切换&lt;br&gt;Proc 族与槽位生命周期&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B6C2D1;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#344054;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="424" y="602" width="320" height="94" as="geometry"/>
        </mxCell>
        <mxCell id="memory-sync" value="&lt;b&gt;内存与同步&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475467&quot;&gt;Hart 私有堆 · 动态扩容&lt;br&gt;事件队列 · 轮询等待 · 子 Thread 汇合&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B6C2D1;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#344054;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="760" y="602" width="320" height="94" as="geometry"/>
        </mxCell>
        <mxCell id="rpc-core" value="&lt;b&gt;RPC 内核&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475467&quot;&gt;事务队列 · 等待与唤醒&lt;br&gt;邮箱传输 · 主机服务调用&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B6C2D1;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#344054;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1096" y="602" width="320" height="94" as="geometry"/>
        </mxCell>
        <mxCell id="profile-trap" value="&lt;b&gt;性能采集与异常处理&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475467&quot;&gt;状态记录缓冲区 · 异步回传&lt;br&gt;异常栈 · 上报 · Proc 失败 / 系统停机&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#F2F4F7;strokeColor=#B6C2D1;align=left;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=15;fontColor=#344054;spacingLeft=14;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1432" y="602" width="400" height="94" as="geometry"/>
        </mxCell>

        <!-- RPC boundary -->
        <mxCell id="rpc-band" value="&lt;b&gt;主机 ↔ 设备端 RPC&lt;/b&gt;　　邮箱 + 门铃 / MSIP + 共享描述符　　&lt;font color=&quot;#475467&quot;&gt;双向控制命令与主机服务调用&lt;/font&gt;" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#EEF4FF;strokeColor=#84ADFF;strokeWidth=1.4;align=center;verticalAlign=middle;fontFamily=Noto Sans CJK SC;fontSize=16;fontColor=#1849A9;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="64" y="754" width="1792" height="56" as="geometry"/>
        </mxCell>

